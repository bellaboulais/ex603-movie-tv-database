erDiagram
    users ||--o{ ratings : gives
    movies ||--o{ ratings : receives
    movies ||--o{ movie_genres : has
    genres ||--o{ movie_genres : categorizes

    users {
        int user_id PK
        string username
        string email
        date date_joined
    }

    movies {
        int movie_id PK
        string title
        int duration_min
        date release_date
    }

    ratings {
        int rating_id PK
        int user_id FK
        int movie_id FK
        float rating
        string comment
        date date
    }

    genres {
        int genre_id PK
        string genre
    }

    movie_genres {
        int movie_id PK, FK
        int genre_id PK, FK
    }